[Unit]
Description=BormoStats Celery Beat Scheduler
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=bormostats
Group=bormostats
WorkingDirectory=/opt/bormostats/workers
EnvironmentFile=/opt/bormostats/.env
Environment=PYTHONPATH=/opt/bormostats/workers:/opt/bormostats
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=CELERY_METRICS_ROLE=beat
Environment=CELERY_METRICS_PORT=9102
Environment=HOME=/tmp
Environment=XDG_CACHE_HOME=/tmp/.cache
ExecStart=/opt/bormostats/.venv/bin/celery -A app.celery_app:celery_app beat --loglevel=INFO --schedule=/tmp/celerybeat-schedule
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
