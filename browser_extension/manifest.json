{
  "manifest_version": 3,
  "name": "BormoStats",
  "version": "1.2.0",
  "description": "Competitor analytics overlay for Wildberries and Ozon",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BormoStats"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.wildberries.ru/*",
        "https://*.ozon.ru/*",
        "https://*.wildberries.by/*"
      ],
      "js": ["protocol.js", "content.js"]
    }
  ]
}
