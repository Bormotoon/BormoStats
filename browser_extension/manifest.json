{
  "manifest_version": 3,
  "name": "BormoStats",
  "version": "1.1.0",
  "description": "Competitor analytics overlay for Wildberries and Ozon",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://*.wildberries.ru/*",
    "https://*.ozon.ru/*",
    "https://*.wildberries.by/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BormoStats"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.wildberries.ru/*",
        "https://*.ozon.ru/*",
        "https://*.wildberries.by/*"
      ],
      "js": ["content.js"]
    }
  ]
}
