# Prod environment template
STACK_NAME=bormostats-prod
APP_ENV=prod
LOG_LEVEL=INFO
TZ=Europe/Warsaw

CH_HOST=clickhouse
CH_PORT=8123
CH_HTTP_HOST_PORT=38123
BOOTSTRAP_CH_HOST=127.0.0.1
BOOTSTRAP_CH_PORT=38123
BOOTSTRAP_CH_ADMIN_USER=bootstrap_admin
BOOTSTRAP_CH_ADMIN_PASSWORD=replace-with-prod-bootstrap-password
CH_USER=analytics_app
CH_PASSWORD=replace-with-prod-clickhouse-password
CH_DB=mp_analytics
CH_POOL_MAXSIZE=16
CH_CONNECT_TIMEOUT_SECONDS=5
CH_QUERY_TIMEOUT_SECONDS=30
CH_RO_USER=
CH_RO_PASSWORD=

REDIS_URL=redis://redis:6379/0
REDIS_USERNAME=bormostats
REDIS_PASSWORD=replace-with-strong-redis-password

BACKEND_HOST_PORT=38080
BACKEND_TLS_HOST_PORT=38443
METABASE_HOST_PORT=33000
WORKER_METRICS_HOST_PORT=39101
BEAT_METRICS_HOST_PORT=39102
TLS_SERVER_NAME=analytics.example.com
TLS_CERT_DAYS=90

CLICKHOUSE_MEMORY_LIMIT=2g
CLICKHOUSE_MEMORY_RESERVATION=512m
CLICKHOUSE_CPU_LIMIT=2.0
REDIS_MEMORY_LIMIT=512m
REDIS_MEMORY_RESERVATION=128m
REDIS_CPU_LIMIT=0.5
BACKEND_MEMORY_LIMIT=512m
BACKEND_MEMORY_RESERVATION=128m
BACKEND_CPU_LIMIT=1.0
WORKER_MEMORY_LIMIT=1g
WORKER_MEMORY_RESERVATION=256m
WORKER_CPU_LIMIT=2.0
BEAT_MEMORY_LIMIT=256m
BEAT_MEMORY_RESERVATION=64m
BEAT_CPU_LIMIT=0.5
METABASE_MEMORY_LIMIT=1g
METABASE_MEMORY_RESERVATION=256m
METABASE_CPU_LIMIT=1.0

WB_TOKEN_STATISTICS=
WB_TOKEN_ANALYTICS=
# Optional WB tokens for write APIs (stocks / prices / ad bids)
WB_TOKEN_MARKETPLACE=
WB_TOKEN_PRICES=
WB_TOKEN_PROMOTION=
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_PERF_API_KEY=
OZON_POSTINGS_SCHEMAS=fbs,fbo
ADMIN_API_KEY=replace-with-prod-admin-key
TG_BOT_TOKEN=
TG_CHAT_ID=

# Security
# Comma-separated CIDRs allowed to use ADMIN_API_KEY (empty = any network)
ADMIN_ALLOWED_NETWORKS=
# Legacy: anonymous reads of default-org analytics (dev only; rejected in stage/prod)
PUBLIC_READ_API=false
# Key for encrypting webhook signing secrets at rest (AES-GCM)
WEBHOOK_SECRET_KEY=replace-with-strong-webhook-secret-key
# Allow webhook targets on private networks (dev only; rejected in stage/prod)
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# Bearer token Prometheus must send to /metrics (empty = no auth, rely on network)
METRICS_BEARER_TOKEN=
# Public UI base URL used in notifications
PUBLIC_BASE_URL=https://analytics.example.com:38443

# Marketplace side effects (bidder / repricer). Rules are dry-run by default;
# live changes additionally require this global switch.
MARKETPLACE_ACTIONS_ENABLED=false
MARKETPLACE_ACTIONS_MAX_PER_RUN=100

# Celery worker sizing and queues (split queues across dedicated workers if needed)
WORKER_CONCURRENCY=4
WORKER_QUEUES=etl,wb,ozon,competitor,automation,marketplace_actions,webhooks

# Backups (scripts/backup.sh)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Optional: GPG recipient used to encrypt backup archives
BACKUP_GPG_RECIPIENT=
